@prefix cobra: <http://exemplo.org/cobras#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# Hierarquia de classes (12 Classes com pelo menos 2 níveis de profundidade)
# ==============================================================================

# --- Raiz 1: Serpentes ---
cobra:Serpente a rdfs:Class .

# Nível 1 abaixo da Raiz 1
cobra:Peconhenta a rdfs:Class ;
    rdfs:subClassOf cobra:Serpente .

cobra:NaoPeconhenta a rdfs:Class ;
    rdfs:subClassOf cobra:Serpente ;
    owl:disjointWith cobra:Peconhenta . # Axioma OWL 1: Disjunção de classes

# Nível 2 abaixo da Raiz 1 (Famílias Peçonhentas)
cobra:Viperidae a rdfs:Class ;
    rdfs:subClassOf cobra:Peconhenta .

cobra:Elapidae a rdfs:Class ;
    rdfs:subClassOf cobra:Peconhenta .

# Nível 2 abaixo da Raiz 1 (Famílias Não Peçonhentas)
cobra:Boidae a rdfs:Class ;
    rdfs:subClassOf cobra:NaoPeconhenta .

cobra:Colubridae a rdfs:Class ;
    rdfs:subClassOf cobra:NaoPeconhenta .

cobra:Aniliidae a rdfs:Class ;
    rdfs:subClassOf cobra:NaoPeconhenta .


# --- Raiz 2: Biomas ---
cobra:Bioma a rdfs:Class .

# Nível 1 abaixo da Raiz 2
cobra:BiomaFlorestal a rdfs:Class ;
    rdfs:subClassOf cobra:Bioma .

cobra:BiomaCampestre a rdfs:Class ;
    rdfs:subClassOf cobra:Bioma .


# --- Raiz 3: Dentição ---
cobra:TipoDenticao a rdfs:Class .


# ==============================================================================
# Propriedades de obejtos (5 ObjectProperties com domain, range e OWL)
# ==============================================================================

# Relação Serpente -> Bioma
cobra:habitaBioma a owl:ObjectProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:Bioma .

# Relação Inversa Bioma -> Serpente
cobra:eHabitadoPor a owl:ObjectProperty ;
    owl:inverseOf cobra:habitaBioma . # Axioma OWL 2: Inversa

# Relação Serpente -> TipoDenticao
cobra:possuiDenticao a owl:ObjectProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:TipoDenticao .

# Relação Simétrica entre Serpentes que compartilham o mesmo ecossistema
cobra:eSimpatricaCom a owl:ObjectProperty, owl:SymmetricProperty ; # Axioma OWL 3: Simetria
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:Serpente .

# Relação Simétrica de Parentesco Taxonômico/Evolutivo entre Serpentes
cobra:temParenteProximo a owl:ObjectProperty, owl:SymmetricProperty ; # Axioma OWL 4: Simetria
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:Serpente .


# ==============================================================================
# Propriedades de dados (6 DatatypeProperties com domain e range)
# ==============================================================================

# Nome Científico (Único por espécie)
cobra:nomeCientifico a owl:DatatypeProperty, owl:FunctionalProperty ; # Axioma OWL 5: Funcional
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:string .

# Nome Popular
cobra:nomePopular a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:string .

# Comprimento Médio em metros
cobra:comprimentoMedioMetros a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:decimal .

# Hábito Noturno (Verdadeiro/Falso)
cobra:eNoturna a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:boolean .

# Nível de Risco de Acidente Ofídico (escala de 1 a 5)
cobra:nivelRiscoAcidente a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:integer .

# Hábitos Alimentares
cobra:alimentacao a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:string .

# ==============================================================================
# Instâncias (27 Instâncias no Total)
# ==============================================================================

# ------------------------------------------------------------------------------
# Instâncias de Biomas (5)
# ------------------------------------------------------------------------------
cobra:Caatinga a cobra:BiomaCampestre .
cobra:Cerrado a cobra:BiomaCampestre .
cobra:MataAtlantica a cobra:BiomaFlorestal .
cobra:Amazonia a cobra:BiomaFlorestal .
cobra:Pantanal a cobra:BiomaCampestre .

# ------------------------------------------------------------------------------
# Instâncias de Tipos de Dentição (4)
# ------------------------------------------------------------------------------
cobra:Solenoglifa a cobra:TipoDenticao .
cobra:Proteroglifa a cobra:TipoDenticao .
cobra:Opistoglifa a cobra:TipoDenticao .
cobra:Aglifa a cobra:TipoDenticao .

# ------------------------------------------------------------------------------
# Instâncias de Viperidae (4 Espécies - Peçonhentas)
# ------------------------------------------------------------------------------
cobra:JararacaDaCaatinga a cobra:Viperidae ;
