    cobra:nomePopular "Jararaca-da-Caatinga" ;
    cobra:comprimentoMedioMetros 0.6 ;
    cobra:eNoturna true ;
    cobra:nivelRiscoAcidente 5 ;
    cobra:alimentacao "Pequenos roedores e lagartos" ;
    cobra:habitaBioma cobra:Caatinga ;
    cobra:possuiDenticao cobra:Solenoglifa ;
    cobra:eSimpatricaCom cobra:Cascavel ;
    cobra:temParenteProximo cobra:JararacaComum .

cobra:JararacaComum a cobra:Viperidae ;
    cobra:nomeCientifico "Bothrops jararaca" ;
    cobra:nomePopular "Jararaca" ;
    cobra:comprimentoMedioMetros 1.2 ;
    cobra:eNoturna true ;
    cobra:nivelRiscoAcidente 5 ;
    cobra:alimentacao "Roedores e sapos" ;
    cobra:habitaBioma cobra:MataAtlantica ;
    cobra:possuiDenticao cobra:Solenoglifa .

cobra:Cascavel a cobra:Viperidae ;
    cobra:nomeCientifico "Crotalus durissus" ;
    cobra:nomePopular "Cascavel" ;
    cobra:comprimentoMedioMetros 1.5 ;
    cobra:eNoturna true ;
    cobra:nivelRiscoAcidente 5 ;
    cobra:alimentacao "Roedores e pequenos mamíferos" ;
    cobra:habitaBioma cobra:Caatinga, cobra:Cerrado ;
    cobra:possuiDenticao cobra:Solenoglifa .

cobra:Surucucu a cobra:Viperidae ;
    cobra:nomeCientifico "Lachesis muta" ;
    cobra:nomePopular "Surucucu-pico-de-jaca" ;
    cobra:comprimentoMedioMetros 2.5 ;
    cobra:eNoturna true ;
    cobra:nivelRiscoAcidente 5 ;
    cobra:alimentacao "Pequenos e médios mamíferos" ;
    cobra:habitaBioma cobra:Amazonia, cobra:MataAtlantica ;
    cobra:possuiDenticao cobra:Solenoglifa .

