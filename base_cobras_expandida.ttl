cobra:CobraCega a cobra:Aniliidae,
        cobra:NaoPeconhenta,
        cobra:Serpente ;
    cobra:alimentacao "Anfíbios subterrâneos e peixes-cobra" ;
    cobra:comprimentoMedioMetros 0.7 ;
    cobra:eNoturna true ;
    cobra:habitaBioma cobra:Amazonia ;
    cobra:nivelRiscoAcidente 1 ;
    cobra:nomeCientifico "Anilius scytale" ;
    cobra:nomePopular "Cobra-cega" ;
    cobra:possuiDenticao cobra:Aglifa ;
