cobra:alimentacao a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cobra:alimentacao ;
    owl:equivalentProperty cobra:alimentacao ;
    owl:sameAs cobra:alimentacao .

cobra:comprimentoMedioMetros a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf cobra:comprimentoMedioMetros ;
    owl:equivalentProperty cobra:comprimentoMedioMetros ;
    owl:sameAs cobra:comprimentoMedioMetros .

cobra:eHabitadoPor a owl:ObjectProperty ;
    rdfs:subPropertyOf cobra:eHabitadoPor ;
    owl:equivalentProperty cobra:eHabitadoPor ;
    owl:inverseOf cobra:habitaBioma ;
    owl:sameAs cobra:eHabitadoPor .

cobra:eNoturna a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf cobra:eNoturna ;
    owl:equivalentProperty cobra:eNoturna ;
    owl:sameAs cobra:eNoturna .

cobra:eSimpatricaCom a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:Serpente ;
    rdfs:subPropertyOf cobra:eSimpatricaCom ;
    owl:equivalentProperty cobra:eSimpatricaCom ;
    owl:sameAs cobra:eSimpatricaCom .

cobra:nivelRiscoAcidente a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf cobra:nivelRiscoAcidente ;
    owl:equivalentProperty cobra:nivelRiscoAcidente ;
    owl:sameAs cobra:nivelRiscoAcidente .

cobra:nomeCientifico a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cobra:nomeCientifico ;
    owl:equivalentProperty cobra:nomeCientifico ;
    owl:sameAs cobra:nomeCientifico .

cobra:nomePopular a owl:DatatypeProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cobra:nomePopular ;
    owl:equivalentProperty cobra:nomePopular ;
    owl:sameAs cobra:nomePopular .

cobra:possuiDenticao a owl:ObjectProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:TipoDenticao ;
    rdfs:subPropertyOf cobra:possuiDenticao ;
    owl:equivalentProperty cobra:possuiDenticao ;
    owl:sameAs cobra:possuiDenticao .

cobra:temParenteProximo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain cobra:Serpente ;
    rdfs:range cobra:Serpente ;
    rdfs:subPropertyOf cobra:temParenteProximo ;
    owl:equivalentProperty cobra:temParenteProximo ;
    owl:sameAs cobra:temParenteProximo .

owl:Class owl:sameAs owl:Class .

owl:Nothing a owl:Class ;
    rdfs:subClassOf owl:Nothing,
        owl:Thing ;
    owl:equivalentClass owl:Nothing ;
    owl:sameAs owl:Nothing .

owl:SymmetricProperty owl:sameAs owl:SymmetricProperty .

